{
    "name": "DSA Portfolio Workspace",
    "image": "mcr.microsoft.com/devcontainers/python:3.13",
    "features": {
        "ghcr.io/astral-sh/uv-devcontainer-features/uv:1": {}
    },
    "postCreateCommand": "cd proj-00-digital-engagement-analytics-for-agribusiness-growth && uv sync --locked && cd ../proj-01-basic-to-advanced-data-eng-ETL-pipelines && uv sync --locked",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-toolsai.jupyter",
                "charliermarsh.ruff"
            ],
            "settings": {
                "python.defaultInterpreterPath": "${workspaceFolder}/proj-00-digital-engagement-analytics-for-agribusiness-growth/.venv/bin/python"
            }
        }
    }
}
