# Copy to .env and adjust values. Do not commit .env or secrets.
# SQLite is the default. Uncomment to put all jobs in one SQLite database:
# DATABASE_URL=sqlite:///./data/pipeline.db
# Or configure PostgreSQL with a URL such as:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/etl
APPLY_MIGRATIONS=true
REQUEST_TIMEOUT_SECONDS=20

EMPLOYEE_API_URL=https://jsonplaceholder.typicode.com/users
EDUCATION_COUNTRY=United Kingdom
# Optional endpoint override; otherwise the URL is built from EDUCATION_COUNTRY.
# EDUCATION_API_URL=https://universities.hipolabs.com/search?country=United+Kingdom
EARTHQUAKE_FEED=all_week
EARTHQUAKE_MAGNITUDE_THRESHOLD=3.0
# Optional complete URL override:
# EARTHQUAKE_API_URL=https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/all_week.geojson

STOCK_TICKER=AAPL
STOCK_PERIOD=5d
STOCK_INTERVAL=1d
STOCK_MAX_STALENESS_DAYS=7

# Optional webhook called by scripts/check_freshness.py when a job is stale.
# ALERT_WEBHOOK_URL=https://example.invalid/your-webhook
